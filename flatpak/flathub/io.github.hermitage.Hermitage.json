{
  "app-id": "io.github.hermitage.Hermitage",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "hermitage",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--filesystem=home:ro",
    "--filesystem=xdg-run/gvfsd",
    "--talk-name=org.gtk.vfs.*"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/man",
    "/share/gtk-doc",
    "/share/hermitage/tools",
    "/cache",
    "/.lock",
    "/.flatpak-builder"
  ],
  "modules": [
    {
      "name": "hermitage",
      "buildsystem": "meson",
      "config-opts": [
        "--buildtype=release"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/hermitage/hermitage.git",
          "tag": "v1.2.1",
          "commit": "962aa5228bbc289ff99e27113ec8e6cab51ced69"
        }
      ]
    }
  ]
}
